# ═══════════════════════════════════════════════════════════════════════════
# MindSpool — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every variable below has a safe default (in [brackets]) so the app boots
# in local-only mode without any cloud services configured.

# ── Server ─────────────────────────────────────────────────────────────────
# The port the Express server listens on. PaaS platforms (Render, Railway,
# Fly) inject this automatically; set it explicitly for local / VPS.
PORT=3000

# Node environment — DO NOT set this in .env. It is set by the npm script:
#   npm run dev   → NODE_ENV=development (Vite dev middleware + HMR)
#   npm start     → NODE_ENV=production  (serves the built dist/ bundle)
# dotenv never overrides a value the script already set, so the run mode is
# always deterministic. Pinning NODE_ENV in .env breaks `npm run dev` by
# forcing the production branch (serves from dist/, no HMR, 404 if dist
# is missing/stale — the "preview keeps going down" failure mode).

# Comma-separated list of allowed CORS origins. The API server rejects
# requests with an Origin header not in this list. Same-origin requests
# (no Origin header) are always allowed. Subdomain wildcards are supported
# (e.g. https://*.space-z.ai).
# Example: https://MindSpool.app,https://www.MindSpool.app
CORS_ORIGIN=

# ── Database (Supabase / Postgres) ────────────────────────────────────────
# Required for cloud sync (posts, reactions, profiles). When absent, the
# app runs in local-only mode (IndexedDB only) — safe for dev/demo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase table used for analytics events (default: analytics_events).
SUPABASE_ANALYTICS_TABLE=
# Request timeout for Supabase REST calls (ms).
SUPABASE_REQUEST_TIMEOUT_MS=2500

# ── Auth (Firebase) ───────────────────────────────────────────────────────
# The Firebase project ID. Used to verify ID token audience + issuer.
# The full client config (apiKey, appId, etc.) lives in
# firebase-applet-config.json — that file contains PUBLIC identifiers only
# and is safe to ship in the client bundle. Security is enforced by
# Firestore Rules + the server-side token verification in
# api-server/src/lib/firebase-auth.ts.
FIREBASE_PROJECT_ID=

# ── Rate Limiting ─────────────────────────────────────────────────────────
# Per-IP request limits. The write limiter is stricter (for POST /events,
# /client-errors); the read limiter is 5x more lenient.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Body size limit for JSON / urlencoded payloads.
BODY_LIMIT=256kb

# Trust proxy setting for Express. Controls how req.ip is derived from
# X-Forwarded-For. Set to the number of trusted proxy hops when deploying
# behind a reverse proxy (Render/Railway/Fly/nginx/Cloud Run = 1), so the
# rate limiter sees the real client IP. Default "false" = direct mode
# (req.ip = socket.remoteAddress, not spoofable). Also accepts "loopback",
# "linklocal", "uniquelocal", or comma-separated CIDRs.
# This is the S-1 security fix — without it, attackers could spoof
# X-Forwarded-For to bypass rate limits.
TRUST_PROXY=false

# ── Logging ───────────────────────────────────────────────────────────────
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Analytics Storage ─────────────────────────────────────────────────────
# Analytics events are stored in Supabase if configured, otherwise in a
# local JSONL file. Set either to disable that storage backend.
ANALYTICS_DISABLE_SUPABASE=false
ANALYTICS_DISABLE_FILE_STORAGE=false
# Override the default analytics file path (default: data/analytics-events.jsonl)
ANALYTICS_EVENTS_FILE=

# ── Error Tracking (optional) ─────────────────────────────────────────────
# Sentry DSN for server-side error tracking. When set, the API server
# sends uncaught errors to Sentry. The client-side error monitor
# (lib/error-monitor.ts) already POSTs to /api/client-errors.
SENTRY_DSN=

# ── Feature Flags ─────────────────────────────────────────────────────────
# Set to "true" to put the app in maintenance mode (returns 503 on all
# routes except /api/healthz). Use during deployments or incidents.
MAINTENANCE_MODE=false

# ── Build / Deploy ────────────────────────────────────────────────────────
# Base path for the Vite build. Use "/" for root deployment, or a subpath
# like "/app/" if the app is served from a subdirectory.
BASE_PATH=/

# ── Phase 8 — Backups (optional) ─────────────────────────────────────────
# Direct Postgres connection string for pg_dump backups.
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_URL=
# Backblaze B2 credentials for off-site backup storage (10 GB free tier).
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# ── Phase 8 — Sentry Release Tracking (optional) ─────────────────────────
# Set to the git SHA in CI for release-level error tracking.
SENTRY_RELEASE=

# ── Phase 0004 — Community Rebuild ────────────────────────────────────────
# Comma-separated list of admin emails. These users can verify/reject
# expert applications via POST /api/experts/:id/verify. Leave empty in
# dev (no admin actions possible until at least one email is set).
# Example: admin@MindSpool.app,moderator@MindSpool.app
ADMIN_EMAILS=

# Rate limiter backing store. Unset → per-instance in-memory counter.
# Set to a Redis URL (redis://… or rediss://…) to share the rate-limit
# budget across all instances behind a load balancer. The limiter falls
# back to in-memory if Redis is unreachable, so a Redis outage never
# takes the API down (the guarantee weakens to per-instance, but stays up).
REDIS_URL=

# ── Frontend build-time variables (Vite) ─────────────────────────────────
# These are inlined into the client bundle at BUILD time (npm run build).
# IMPORTANT: an EMPTY VITE_API_BASE_URL means SAME-ORIGIN — the normal,
# fully-cloud-connected production setup (the SPA and /api/* are served by
# the same Express host). Set it only when the API lives on a different
# host. Set VITE_LOCAL_ONLY=1 for a fully offline build (no API calls).
VITE_API_BASE_URL=
# Per-request API timeout (ms) in the client.
VITE_API_TIMEOUT=15000
# Client feature flags.
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_SOCIAL_FEATURES=true
# Fully offline/local-only build (skips ALL cloud API calls).
VITE_LOCAL_ONLY=false
