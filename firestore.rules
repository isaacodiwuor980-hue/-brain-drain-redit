rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: a user must be signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: the signed-in user owns the document by UID.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper: only allow known profile fields and reasonable sizes.
    function validProfile() {
      let data = request.resource.data;
      return data.id is string &&
             data.username is string &&
             data.username.size() > 0 && data.username.size() <= 40 &&
             data.displayName is string && data.displayName.size() <= 80 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('followerCount' in data) || data.followerCount is int) &&
             (!('followingCount' in data) || data.followingCount is int);
    }

    // Default deny for anything not explicitly matched below.
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: readable by any signed-in user; only the owner writes.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && validProfile();
      allow update: if isOwner(userId) && validProfile();
      allow delete: if isOwner(userId);
    }

    // Personality test answers are private to the user.
    match /personality_tests/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- Gamification & Challenges (Phase 1-6 Extensions) ---
    
    match /daily_challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if false; // Only Cloud Functions / Admins should create challenges
    }
    
    match /user_challenge_attempts/{attemptId} {
      // Must use request.resource on create
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false; // Immutable after creation
    }
    
    match /leaderboards/{leaderboardId} {
      allow read: if request.auth != null;
      allow write: if false; // Managed by Cloud Functions cron job
    }
    
    match /user_achievements/{achievementId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false; // Managed by Cloud Functions based on triggers
    }
    
    match /realtime_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUserId == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.hostUserId || 
        request.auth.uid in resource.data.participants
      );
    }
    
    // Boards & Pins
    match /boards/{boardId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(request.resource.data.ownerId);
    }
    match /pins/{pinId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}
