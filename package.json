    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "date-fns": "^3.6.0",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "framer-motion": "^11.15.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.468.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.0",
